# PhysioDesk Backend – Environment Variables
# Copy this file to `.env` and fill in real values.

# PostgreSQL connection string.
# Local dev (docker run mapping 5434→5432):  postgresql://postgres:postgres@localhost:5434/physiodesk
# Docker Compose (service-to-service):       postgresql://postgres:postgres@db:5432/physiodesk
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/physiodesk

# JWT signing secret — MUST be changed in production.
SECRET_KEY=change-me-in-production

# Token lifetimes (defaults shown).
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
